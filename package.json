{
    "name": "talentflow-monorepo",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "test": "turbo run test",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
        "db:push": "pnpm --filter @talentflow/database db:push",
        "db:migrate": "pnpm --filter @talentflow/database db:migrate",
        "db:studio": "pnpm --filter @talentflow/database db:studio"
    },
    "devDependencies": {
        "turbo": "^1.11.0",
        "prettier": "^3.1.0",
        "typescript": "^5.3.0"
    }
}